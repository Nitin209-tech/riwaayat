# ═══════════════════════════════════════
# RIWAAYAT PLATFORM - Environment Config
# ═══════════════════════════════════════

# ── DATABASE (PostgreSQL via Prisma) ──
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/riwaayat_db?schema=public"

# ── BACKEND SERVER ──
PORT=5000
FRONTEND_URL="http://localhost:3000"

# ── JWT AUTH SECRET (change this!) ──
JWT_SECRET="generate-a-random-64-char-string-here"

# ── ENCRYPTION KEY (exactly 32 chars) ──
ENCRYPTION_SECRET="generate-a-random-32-char-string"

# ── DISCORD OAUTH & BOT ──
DISCORD_CLIENT_ID="your_discord_app_client_id"
DISCORD_CLIENT_SECRET="your_discord_app_client_secret"
DISCORD_BOT_TOKEN="your_discord_bot_token"

# ── EMAIL (Resend.com) ──
RESEND_API_KEY="re_your_resend_api_key"
